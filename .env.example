# Secrets are entered by the owner in the UI, not committed in this file.
DATA_DIR=data
SECURE_COOKIES=false
AGENT_WORKERS=2
# No fixed model-round limit. MAX_RUN_STEPS from older .env files is ignored.
MAX_RUN_SECONDS=180
# Retired: MAX_CONTEXT_CHARS is ignored; actual provider context limits apply.
MAX_TOOL_CHARS=22000
MAX_DAILY_REQUESTS=50
MAX_UPLOAD_MB=100
ALLOW_PRIVATE_MODEL_URLS=false
SCIENCE_TIMEOUT=15
SCIENCE_CPU_SECONDS=10
SCIENCE_MEMORY_MB=512

# Compose wires the isolated Python service and generates a private shared token.
# Bare-host development must configure a broker; an empty URL fails closed.
PYTHON_SANDBOX_URL=
PYTHON_SANDBOX_TOKEN_FILE=/run/masar-sandbox/token

# Optional SMTP: authenticated STARTTLS, links never written to frontend/source/logs.
PUBLIC_ORIGIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
REQUIRE_VERIFIED_EMAIL=false
TRUSTED_HOSTS=
# HTTPS deployment overlay only; set to a hostname and operator email.
DOMAIN=
TLS_EMAIL=
