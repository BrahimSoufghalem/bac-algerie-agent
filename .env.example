# Secrets are entered by the owner in the UI, not committed in this file.
DATA_DIR=data
SECURE_COOKIES=false
AGENT_WORKERS=2
EXTRACTION_WORKERS=2
# No fixed model-round limit. MAX_RUN_STEPS from older .env files is ignored.
MAX_RUN_SECONDS=180
MAX_CONTEXT_CHARS=60000
MAX_TOOL_CHARS=22000
MAX_DAILY_REQUESTS=50
MAX_UPLOAD_MB=100
PAGE_DPI=200
MAX_RETRIES=3
MIN_REQUEST_INTERVAL=0.25
MAX_PIXELS=16000000
MAX_PAGES=10000
REQUEST_TIMEOUT=180
LEASE_SECONDS=240
ALLOW_PRIVATE_MODEL_URLS=false
SCIENCE_TIMEOUT=6
SCIENCE_CPU_SECONDS=4
SCIENCE_MEMORY_MB=256

# Optional SMTP: authenticated STARTTLS, links never written to frontend/source/logs.
PUBLIC_ORIGIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
REQUIRE_VERIFIED_EMAIL=false
TRUSTED_HOSTS=
# HTTPS deployment overlay only; set to a hostname and operator email.
DOMAIN=
TLS_EMAIL=
